{
  "name": "councilorg",
  "version": "5.0.0",
  "description": "555 reference roles + 35 org presets + LLM Council architecture. Organizational design engine for Claude Code.",
  "keywords": [
    "org-framework",
    "company-structure",
    "roles",
    "presets",
    "claude-code",
    "llm-council",
    "org-intelligence",
    "organizational-design"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/korishnn/councilorg"
  },
  "bin": {
    "councilorg": "bin/install.sh"
  },
  "files": [
    "bin/",
    ".claude/",
    "tests/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./reverse-org": "./.claude/councilorg/reverse-org/designer.js",
    "./vacancy": "./.claude/councilorg/vacancy/simulator.js",
    "./similarity": "./.claude/councilorg/similarity/search.js",
    "./role-to-task": "./.claude/councilorg/role-to-task/generate.js",
    "./comparison": "./.claude/councilorg/comparison/comparison.js",
    "./visualizer": "./.claude/councilorg/visualizer/generate.js",
    "./relationship-map": "./.claude/councilorg/relationship-map/relationship-map.js",
    "./diagnose": "./bin/diagnose.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --experimental-vm-modules ./node_modules/vitest/vitest.mjs run --coverage",
    "test:watch": "vitest",
    "test:validate": "node tests/validate-roles.js && node tests/validate-presets.js && node tests/validate-index.js",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration/",
    "test:all": "vitest run && node tests/validate-roles.js && node tests/validate-presets.js && node tests/validate-index.js",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern .git",
    "typecheck": "tsc --noEmit",
    "diagnose": "node bin/diagnose.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

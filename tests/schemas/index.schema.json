{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orgframework.dev/schemas/index.schema.json",
  "title": "Org Framework Index",
  "description": "Schema for the main index.json file",
  "type": "object",
  "required": ["version", "philosophy", "regions", "industries", "stages", "reference_roles", "org_construction_guidance"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "philosophy": {
      "type": "string",
      "description": "Core philosophy statement"
    },
    "philosophy_v3": {
      "type": "string",
      "description": "v3-specific philosophy"
    },
    "regions": {
      "type": "object",
      "required": ["options", "detection"],
      "properties": {
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "detection": {
          "type": "object",
          "description": "Detection keywords per region"
        }
      }
    },
    "industries": {
      "type": "object",
      "required": ["options", "detection"],
      "properties": {
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "detection": {
          "type": "object",
          "description": "Detection keywords per industry"
        }
      }
    },
    "stages": {
      "type": "object",
      "required": ["options"],
      "properties": {
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reference_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
      }
    },
    "deprecated_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "org_construction_guidance": {
      "type": "object",
      "required": ["how_it_works", "what_to_consider", "what_you_can_create"],
      "properties": {
        "how_it_works": { "type": "string" },
        "what_to_consider": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "what_you_can_create": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    }
  }
}

  "council_file": "council/100-members.json",
  "core_members": [
    {
      "id": "strategist",
      "name": "The Strategist",
      "signature_question": "Does this structure serve our 3-year strategy?",
      "focus": "Long-term vision, market fit, competitive positioning, strategic optionality"
    },
    {
      "id": "operator",
      "name": "The Operator",
      "signature_question": "Who actually does the work and where does it get stuck?",
      "focus": "Execution, bottlenecks, spans of control, operational flow"
    },
    {
      "id": "financial-controller",
      "name": "The Financial Controller",
      "signature_question": "What does this cost and is it sustainable?",
      "focus": "Budget, burn rate, comp sanity, unit economics, ROI"
    },
    {
      "id": "culture-keeper",
      "name": "The Culture Keeper",
      "signature_question": "What culture does this structure produce?",
      "focus": "Values, psychological safety, rituals, inclusion, belonging"
    },
    {
      "id": "pessimist",
      "name": "The Pessimist",
      "signature_question": "What breaks first and who do we lose?",
      "focus": "Failure modes, single points of failure, risk, second-order effects"
    },
    {
      "id": "regulatory-hawk",
      "name": "The Regulatory Hawk",
      "signature_question": "Which regulator knocks on our door first?",
      "focus": "Compliance, law, jurisdiction, regulatory risk"
    },
    {
      "id": "talent-scout",
      "name": "The Talent Scout",
      "signature_question": "Can we actually hire these people, here, now?",
      "focus": "Hiring feasibility, market fit, talent availability, comp competitiveness"
    },
    {
      "id": "systems-architect",
      "name": "The Systems Architect",
      "signature_question": "What system architecture does this org produce?",
      "focus": "Conway's Law, team topology, coupling, cohesion, platform design"
    }
  ],

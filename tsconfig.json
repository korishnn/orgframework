{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    ".claude/orgframework/lib/types.js",
    ".claude/orgframework/lib/errors.js",
    ".claude/orgframework/lib/paths.js",
    ".claude/orgframework/lib/constants.js",
    ".claude/orgframework/similarity/search.js",
    ".claude/orgframework/vacancy/simulator.js",
    ".claude/orgframework/comparison/comparison.js",
    ".claude/orgframework/reverse-org/designer.js",
    ".claude/orgframework/visualizer/generate.js",
    ".claude/orgframework/relationship-map/relationship-map.js",
    ".claude/orgframework/council/orchestrator.js",
    ".claude/orgframework/role-to-task/generate.js"
  ],
  "exclude": [
    "node_modules"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    ".claude/councilorg/lib/types.js",
    ".claude/councilorg/lib/errors.js",
    ".claude/councilorg/lib/paths.js",
    ".claude/councilorg/lib/constants.js",
    ".claude/councilorg/similarity/search.js",
    ".claude/councilorg/vacancy/simulator.js",
    ".claude/councilorg/comparison/comparison.js",
    ".claude/councilorg/reverse-org/designer.js",
    ".claude/councilorg/visualizer/generate.js",
    ".claude/councilorg/relationship-map/relationship-map.js",
    ".claude/councilorg/council/orchestrator.js",
    ".claude/councilorg/role-to-task/generate.js",
    "bin/councilorg.js",
    "bin/diagnose.js",
    "bin/install.js",
    "bin/cli/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
